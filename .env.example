# ============================================================
# Hórus PDV — variáveis do Docker Compose
# Copie para .env e troque TODOS os valores antes de usar.
# ============================================================

# Senha do SA do SQL Server (min. 8 chars, maiúscula, minúscula, número e símbolo)
MSSQL_SA_PASSWORD=TroqueEstaSenha@2026

# Segredos da API — gere com: openssl rand -base64 48
AUTH_JWT_SECRET=
SECURITY_ENCRYPTION_KEY=

# Portas expostas no host
WEB_PORT=8080
API_PORT=5260
DB_PORT=1433

# Ambiente da API: Development (Swagger ligado) ou Production
ASPNETCORE_ENVIRONMENT=Development

# Origem do frontend
FRONTEND_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080

# reCAPTCHA v3 (opcional)
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# SMTP para recuperação de senha (opcional)
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
